Model fct_lounge_review {
  type: 'table'
  label: 'Lounge Reviews'
  description: 'One row per Skytrax lounge review.'
  data_source_name: 'skytrax'
  table_name: '"lounge_reviews"."fct_lounge_review"'

  dimension review_id {
    label: 'Review Id'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.review_id }};;
  }
  dimension airline_id {
    label: 'Airline Id'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.airline_id }};;
  }
  dimension date_submitted {
    label: 'Date Submitted'
    type: 'date'
    definition: @sql {{ #SOURCE.date_submitted_id }};;
  }
  dimension type_of_traveller {
    label: 'Type Of Traveller'
    type: 'text'
    definition: @sql {{ #SOURCE.type_of_traveller }};;
  }
  dimension average_rating {
    label: 'Average Rating'
    type: 'number'
    description: 'Mean of the sub-ratings the reviewer filled in (1-5).'
    definition: @sql {{ #SOURCE.average_rating }};;
  }
  dimension recommended {
    label: 'Recommended'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.recommended }};;
  }
  dimension comfort {
    label: 'Comfort'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.comfort }};;
  }
  dimension cleanliness {
    label: 'Cleanliness'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.cleanliness }};;
  }
  dimension bar_and_beverages {
    label: 'Bar & Beverages'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.bar_and_beverages }};;
  }
  dimension catering {
    label: 'Catering'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.catering }};;
  }
  dimension staff_service {
    label: 'Staff Service'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.staff_service }};;
  }

  measure review_count {
    label: 'Reviews'
    type: 'number'
    description: 'Number of reviews.'
    definition: @sql {{ review_id }};;
    aggregation_type: 'count'
  }
  measure avg_rating {
    label: 'Avg Rating'
    type: 'number'
    description: 'Average of average_rating across reviews (1-5).'
    definition: @sql {{ average_rating }};;
    aggregation_type: 'avg'
  }
  measure recommend_rate {
    label: '% Recommended'
    type: 'number'
    description: 'Share of reviews where the reviewer recommends it.'
    definition: @sql CASE WHEN {{ recommended }} THEN 1.0 ELSE 0.0 END;;
    aggregation_type: 'avg'
  }
  measure avg_comfort {
    label: 'Avg Comfort'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ comfort }};;
    aggregation_type: 'avg'
  }
  measure avg_cleanliness {
    label: 'Avg Cleanliness'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ cleanliness }};;
    aggregation_type: 'avg'
  }
  measure avg_bar_and_beverages {
    label: 'Avg Bar & Beverages'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ bar_and_beverages }};;
    aggregation_type: 'avg'
  }
  measure avg_catering {
    label: 'Avg Catering'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ catering }};;
    aggregation_type: 'avg'
  }
  measure avg_staff_service {
    label: 'Avg Staff Service'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ staff_service }};;
    aggregation_type: 'avg'
  }
}
