Model fct_airport_review {
  type: 'table'
  label: 'Airport Reviews'
  description: 'One row per Skytrax airport review.'
  data_source_name: 'skytrax'
  table_name: '"airport_reviews"."fct_airport_review"'

  dimension review_id {
    label: 'Review Id'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.review_id }};;
  }
  dimension airport_id {
    label: 'Airport Id'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.airport_id }};;
  }
  dimension date_submitted {
    label: 'Date Submitted'
    type: 'date'
    definition: @sql {{ #SOURCE.date_submitted_id }};;
  }
  dimension type_of_traveller {
    label: 'Type Of Traveller'
    type: 'text'
    definition: @sql {{ #SOURCE.type_of_traveller }};;
  }
  dimension average_rating {
    label: 'Average Rating'
    type: 'number'
    description: 'Mean of the sub-ratings the reviewer filled in (1-5).'
    definition: @sql {{ #SOURCE.average_rating }};;
  }
  dimension recommended {
    label: 'Recommended'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.recommended }};;
  }
  dimension queuing_times {
    label: 'Queuing Times'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.queuing_times }};;
  }
  dimension terminal_cleanliness {
    label: 'Terminal Cleanliness'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.terminal_cleanliness }};;
  }
  dimension terminal_signs {
    label: 'Terminal Signs'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.terminal_signs }};;
  }
  dimension airport_shopping {
    label: 'Shopping'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.airport_shopping }};;
  }
  dimension airport_staff {
    label: 'Airport Staff'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.airport_staff }};;
  }

  measure review_count {
    label: 'Reviews'
    type: 'number'
    description: 'Number of reviews.'
    definition: @sql {{ review_id }};;
    aggregation_type: 'count'
  }
  measure avg_rating {
    label: 'Avg Rating'
    type: 'number'
    description: 'Average of average_rating across reviews (1-5).'
    definition: @sql {{ average_rating }};;
    aggregation_type: 'avg'
  }
  measure recommend_rate {
    label: '% Recommended'
    type: 'number'
    description: 'Share of reviews where the reviewer recommends it.'
    definition: @sql CASE WHEN {{ recommended }} THEN 1.0 ELSE 0.0 END;;
    aggregation_type: 'avg'
  }
  measure avg_queuing_times {
    label: 'Avg Queuing Times'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ queuing_times }};;
    aggregation_type: 'avg'
  }
  measure avg_terminal_cleanliness {
    label: 'Avg Terminal Cleanliness'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ terminal_cleanliness }};;
    aggregation_type: 'avg'
  }
  measure avg_terminal_signs {
    label: 'Avg Terminal Signs'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ terminal_signs }};;
    aggregation_type: 'avg'
  }
  measure avg_airport_shopping {
    label: 'Avg Shopping'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ airport_shopping }};;
    aggregation_type: 'avg'
  }
  measure avg_airport_staff {
    label: 'Avg Airport Staff'
    type: 'number'
    description: '1-5; reviews that left it blank are skipped.'
    definition: @sql {{ airport_staff }};;
    aggregation_type: 'avg'
  }
}
